# ---------------------------------------------------------------------------
# Local development (see .env.example notes at the bottom for deployment)
# ---------------------------------------------------------------------------
NODE_ENV=development
LOCAL_INFRA_FALLBACK=true
PORT=3000
HOST=0.0.0.0
# Only enable behind a platform proxy that sets X-Forwarded-For (Render,
# Vercel, Fly). Leave false when the service is exposed directly, otherwise a
# client can spoof its own IP through the header.
TRUST_PROXY=false
DATABASE_URL=postgres://withdrawal:withdrawal@localhost:5432/withdrawal
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-long-admin-secret
ADMIN_USERNAME=replace-with-the-admin-username
ADMIN_WITHDRAWAL_USER_ID=replace-with-gateway-user-uuid
PAYMENT_WEBHOOK_SECRET=replace-with-a-webhook-signing-secret
MIN_WITHDRAWAL=1.00
MAX_WITHDRAWAL=100000.00
WORKER_CONCURRENCY=10
PROCESSING_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Deployment notes
#
# Every value above is read from process.env only, so a hosted platform just
# needs the same names set in its dashboard. Nothing else has to change.
#
# Aliases, for dashboards that prefer these spellings. config/env.ts folds
# each onto its canonical name, and the canonical name always wins if both
# are set:
#
#   ADMIN_PASSWORD  ->  ADMIN_API_KEY            (console sign-in password)
#   WEBHOOK_SECRET  ->  PAYMENT_WEBHOOK_SECRET   (provider HMAC signing key)
#
# Additional variables that only matter once deployed:
#
#   OUTBOX_PUBLISHER_ENABLED  set false on serverless (Vercel) so a cold start
#                             does not spawn a second publisher; leave true on a
#                             long-lived host such as Render.
#   TRUST_PROXY               set true behind Render/Vercel/Fly.
#
# The Android APK takes its backend from the build, not from this file:
# API_BASE_URL, GATEWAY_USER_ID, WEBHOOK_SECRET, USSD_PREFIX, USSD_PIN are
# passed to the Gradle build (see README, "Build the Android APK").
# ---------------------------------------------------------------------------