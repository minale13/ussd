{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "memory": 1024,
        "maxDuration": 60
      },
      "includeFiles": [
        "dist/**"
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "TRUST_PROXY": "true",
    "OUTBOX_PUBLISHER_ENABLED": "false"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
