<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Runtime (dangerous) permissions. MainActivity requests whatever is missing
      at startup with one RequestMultiplePermissions call, so Android shows its
      own sequential Allow / Deny dialogs before the user does anything else:

        CALL_PHONE       UssdPollingService places the USSD payout call.
        READ_PHONE_STATE Sims.kt lists SIM 1 / SIM 2 and reads the carrier name.

      READ_PHONE_STATE doubles as the SIM-slot permission on API 29+. There is
      deliberately no READ_SMS / RECEIVE_SMS / SEND_SMS: this app never touches
      SMS. Declaring permissions it does not use is the single most common reason
      Play rejects an upload, and it makes Play Protect more suspicious of a
      sideload rather than less. Accessibility cannot be requested from code, so
      it is the one grant the onboarding card walks the user to system settings for.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Resumes polling after a reboot when the gateway was left running; the
         boot broadcast itself is protected and only sent by the system. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the dashboard read the gateway's live connection state. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Wakes the polling service when the payout queue is due to be checked. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      The phone makes calls, so declare the hardware as required: Play Store
      filters the listing to devices that can actually run a USSD gateway rather
      than offering it to tablets with no telephony radio.
    -->
    <uses-feature android:name="android.hardware.telephony" android:required="true" />
    <uses-feature android:name="android.hardware.telephony.gsm" android:required="true" />

    <!--
      The accessibility service reads the USSD menu to complete a configured
      payout. Play requires this declaration to be justified in the console, and
      the service must be able to retrieve window content to parse the menu.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.App"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".UssdPollingService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="polling a configured withdrawal gateway" />
        </service>
        <!-- Puts the gateway back to work after a reboot when it was left running.
             Exported because some Android 12+ builds only deliver boot broadcasts
             to exported receivers; ACTION_BOOT_COMPLETED is a protected broadcast
             that third-party apps cannot send, so nothing else can reach it. -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service android:name=".UssdAccessibilityService" android:label="@string/app_name" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="false">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/ussd_accessibility_service" />
        </service>
    </application>
</manifest>