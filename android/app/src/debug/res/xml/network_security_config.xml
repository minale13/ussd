<!--
  Debug-only override of the release network policy.

  A debug build is what a developer points at http://10.0.2.2:3000/ (the host
  machine as seen from the emulator) or at a LAN address for a physical handset.
  Both are plain HTTP, so the release policy in src/main would reject every
  request. This file lives in the debug source set only and is never compiled
  into the release APK, which keeps production on HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
