node_modules/
dist/
# Compiled output for the serverless function. `npm run build` regenerates it
# (tsconfig.api.json). It is deliberately NOT gitignored from Vercel: everything
# under api/ ships with the function, which is what api/index.js now relies on.
api/lib/
# Same reasoning for the App Agent assets: scripts/copy-app-assets.mjs stages
# them into api/ during the build, so they are produced on every build and must
# never be committed as a second copy of the Android source of truth.
api/assets/
.env
coverage/

# Android / Gradle build output
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
*.apk
*.aab
*.keystore
*.jks
# A release signing key must never be committed. *.jks / *.keystore are ignored
# above and NOT un-ignored here, so android/release-keystore.jks stays private.
# Only the development key is tracked, so a fresh clone can still build a debug
# APK; a release APK should be signed with a key you generated yourself (see
# scripts/make-release-keystore.mjs) or a Play upload key.
!android/app/keystore.jks

# OS / editor / temp
.DS_Store
Thumbs.db
*.log
*.txt
.tmp-*

# Local preview logs
admin-preview.log

# Scratch launcher for the local UI preview server
do-prev.cmd
